{
  "name": "dsh-copilot-catalog",
  "version": "0.2.4",
  "description": "Account-aware GitHub Copilot model discovery and Copilot-compatible wire identity for DeepSeek Harness, wrapping the existing pi-ai adapter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "pnpm run build && node --import tsx --test test/catalog.test.ts test/discovery.test.ts test/identity.test.ts test/plugin.test.ts test/secrets.test.ts",
    "check": "pnpm run typecheck && tsx ../../scripts/check.ts",
    "verify": "pnpm run check:secrets && pnpm run check && pnpm run test && pnpm run test:integration && pnpm run test:types && pnpm run test:pack",
    "check:secrets": "tsx ../../scripts/check-secrets.ts",
    "test:types": "pnpm run build && tsc -p test/types/tsconfig.json",
    "test:integration": "pnpm run build && node --import tsx --test test/integration/runtime.test.ts test/integration/enterprise.test.ts test/integration/identity-wire.test.ts",
    "test:pack": "pnpm run build && tsx ../../scripts/check-pack.ts .",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis-plugin",
    "github-copilot",
    "model-catalog",
    "oauth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1yefuwang1/dsh-copilot-catalog.git",
    "directory": "packages/catalog"
  },
  "homepage": "https://github.com/1yefuwang1/dsh-copilot-catalog/tree/main/packages/catalog#readme",
  "bugs": {
    "url": "https://github.com/1yefuwang1/dsh-copilot-catalog/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@earendil-works/pi-ai": "^1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

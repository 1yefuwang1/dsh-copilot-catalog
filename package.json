{
  "name": "dsh-copilot-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Five independent DeepSeek Harness plugins: Copilot model discovery, native web search, a Copilot Gemini tool-declaration guard, projects/worktrees, and Azure Blob + Table conversation sync.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm run build && tsc -p scripts/tsconfig.json && pnpm -r run typecheck",
    "test": "pnpm run test:tooling && pnpm -r run test",
    "test:tooling": "node --import tsx --test scripts/test/workspaces.test.ts",
    "test:integration": "pnpm -r run test:integration",
    "test:types": "pnpm -r run test:types",
    "test:pack": "pnpm run build && tsx scripts/check-pack.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check": "pnpm run typecheck && tsx scripts/check.ts",
    "verify": "pnpm run check:secrets && pnpm run check && pnpm run test && pnpm run test:integration && pnpm run test:types && pnpm run test:pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1yefuwang1/dsh-copilot-catalog.git"
  },
